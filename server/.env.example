PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mylineup
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
FOOTBALL_API_KEY=get-from-football-data.org
BASKETBALL_API_KEY=get-from-balldontlie.io
# Required in production (forgot-password emails silently no-op without it —
# see utils/email.js). Get a key from resend.com; free tier is plenty for this.
RESEND_API_KEY=get-from-resend.com
# Optional — defaults to Resend's shared onboarding@resend.dev sender, which
# works without verifying your own domain but is best swapped for a domain
# you control before sending real traffic.
EMAIL_FROM=MyLineUp <onboarding@resend.dev>
# Required in production. Shared secret checked against the x-internal-secret
# header on POST /api/internal/refresh-snapshots — the GitHub Actions cron in
# .github/workflows/refresh-snapshots.yml sends this same value from a repo
# secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_REFRESH_SECRET=replace-with-a-long-random-string
# Optional, comma-separated. Only set this if your local resolver fails Atlas
# SRV lookups — leave unset in production/hosted environments.
# DNS_SERVERS=8.8.8.8
# Dev-only, never required to run the app — used solely by
# scripts/tailRenderLogs.js to pull production logs into your terminal.
# RENDER_API_KEY: Render dashboard → Account Settings → API Keys → Create API Key
# RENDER_SERVICE_ID: the "srv-..." id in your service's Render dashboard URL
RENDER_API_KEY=get-from-render-dashboard
RENDER_SERVICE_ID=srv-your-service-id
